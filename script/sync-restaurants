#!/usr/bin/env bash
set -euo pipefail

VAULT_PATH="${1:-$HOME/Sync/Recipes}"
SITE_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RESTAURANTS_DIR="$SITE_DIR/_restaurants"
IMAGES_DIR="$SITE_DIR/assets/images/restaurants"

mkdir -p "$RESTAURANTS_DIR" "$IMAGES_DIR"

# Clean old synced restaurants
rm -f "$RESTAURANTS_DIR"/*.md

for file in "$VAULT_PATH/restaurants/"*.md; do
  [ -f "$file" ] || continue

  filename="$(basename "$file" .md)"
  slug="$filename"

  # Extract title from first H1, fall back to filename
  title="$(grep -m1 '^# ' "$file" | sed 's/^# //' || true)"
  if [ -z "$title" ]; then
    title="$filename"
  fi

  # Extract image filename from markdown or Obsidian embed syntax
  # Standard: ![alt](../assets/image.jpg)
  # Obsidian: ![[image.jpg|size]]
  image="$(sed -n 's/.*!\[.*\](\.\.\/assets\/\(.*\))/\1/p' "$file" | head -1)"
  if [ -z "$image" ]; then
    image="$(sed -n 's/.*!\[\[\(.*\)\]\]/\1/p' "$file" | sed 's/|.*//' | head -1)"
  fi

  # Copy image if it exists
  if [ -n "$image" ] && [ -f "$VAULT_PATH/restaurant_assets/$image" ]; then
    cp "$VAULT_PATH/restaurant_assets/$image" "$IMAGES_DIR/$image"
  fi

  # Extract fields (first non-empty line between ## Header and next ##)
  cuisine="$(awk '/^## Cuisine/{flag=1; next} /^## /{flag=0} flag && NF' "$file" | head -1 | xargs)"
  price="$(awk '/^## Price/{flag=1; next} /^## /{flag=0} flag && NF' "$file" | head -1 | xargs)"
  image_position="$(awk '/^## Image Position/{flag=1; next} /^## /{flag=0} flag && NF' "$file" | head -1 | xargs)"
  image_scale="$(awk '/^## Image Scale/{flag=1; next} /^## /{flag=0} flag && NF' "$file" | head -1 | xargs)"
  website="$(awk '/^## Website/{flag=1; next} /^## /{flag=0} flag && NF' "$file" | head -1 | xargs)"
  menu="$(awk '/^## Menu/{flag=1; next} /^## /{flag=0} flag && NF' "$file" | head -1 | xargs)"
  address="$(awk '/^## Address/{flag=1; next} /^## /{flag=0} flag && NF' "$file" | head -1 | xargs)"

  # Extract description (lines between ## Description and next ##)
  description="$(awk '/^## Description/{flag=1; next} /^## /{flag=0} flag' "$file")"

  cat > "$RESTAURANTS_DIR/$slug.md" <<FRONTMATTER
---
title: "$title"
slug: "$slug"
image: "$image"
cuisine: "$cuisine"
price: "$price"
image_position: "$image_position"
image_scale: "$image_scale"
website: "$website"
menu: "$menu"
address: "$address"
---

$description
FRONTMATTER

  echo "Synced: $title"
done

echo "Done. $(ls "$RESTAURANTS_DIR"/*.md 2>/dev/null | wc -l | tr -d ' ') restaurants synced."
