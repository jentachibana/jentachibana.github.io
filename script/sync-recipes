#!/usr/bin/env ruby
# frozen_string_literal: true

require "date"
require "fileutils"
require "yaml"

vault = File.expand_path(ARGV.fetch(0, File.join(Dir.home, "Sync/Recipes")))
site = File.expand_path("..", __dir__)
recipes_dir = File.join(site, "_recipes")
images_dir = File.join(site, "assets/images/recipes")

FileUtils.mkdir_p([recipes_dir, images_dir])
Dir.glob(File.join(recipes_dir, "*.md")).each { |path| File.delete(path) }

def read_note(path)
  parts = File.read(path).split(/^---\s*$\n/, 3)
  raise "Missing frontmatter in #{path}" unless parts.length == 3

  [YAML.safe_load(parts[1], permitted_classes: [Date], aliases: false) || {}, parts[2]]
end

def section(body, name)
  match = body.match(/^##\s+#{Regexp.escape(name)}\s*$\n(.*?)(?=^##\s+|\z)/mi)
  match ? match[1].strip : ""
end

def markdown_list(text, ordered: false)
  text.lines.map(&:strip).reject(&:empty?).each_with_index.map do |line, index|
    "#{ordered ? "#{index + 1}." : "-"} #{line}"
  end.join("\n")
end

Dir.glob(File.join(vault, "recipes", "*.md")).sort.each do |path|
  metadata, body = read_note(path)
  slug = File.basename(path, ".md")
  images = body.scan(/!\[\[([^\]|]+)(?:\|[^\]]+)?\]\]/).flatten.map { |image| File.basename(image) }.uniq

  images.each do |image|
    source = [File.join(vault, "photos", image), File.join(vault, "recipe_assets", image)].find { |candidate| File.file?(candidate) }
    FileUtils.cp(source, File.join(images_dir, image)) if source
  end

  output_metadata = {
    "title" => metadata.fetch("title", slug),
    "slug" => slug,
    "images" => images,
    "cuisine" => metadata["cuisine"].to_s,
    "type" => metadata["type"].to_s,
    "image_position" => metadata["image_position"].to_s,
    "image_scale" => metadata["image_scale"].to_s,
    "date_added" => metadata["date_added"].to_s,
    "blurb" => section(body, "Blurb"),
    "link" => section(body, "Link")
  }

  recipe_body = <<~MARKDOWN
    ## Ingredients

    #{markdown_list(section(body, "Ingredients"))}

    ## Instructions

    #{markdown_list(section(body, "Instructions"), ordered: true)}
  MARKDOWN

  yaml = YAML.dump(output_metadata, line_width: -1).sub(/\A---\s*\n/, "")
  File.write(File.join(recipes_dir, "#{slug}.md"), "---\n#{yaml}---\n\n#{recipe_body}")
  puts "Synced: #{output_metadata['title']}"
end

puts "Done. #{Dir.glob(File.join(recipes_dir, '*.md')).length} recipes synced."
