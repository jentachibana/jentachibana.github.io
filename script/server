#!/usr/bin/env bash
set -euo pipefail

DIR="$(dirname "$0")"
REPO_ROOT="$(cd "$DIR/.." && pwd)"

"$DIR/sync-recipes"

PIDS_TO_KILL=()
cleanup() {
  for pid in "${PIDS_TO_KILL[@]}"; do
    kill "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT

if command -v fswatch &>/dev/null; then
  "$DIR/watch-recipes" &
  PIDS_TO_KILL+=($!)
else
  echo "[server] fswatch not found — recipe auto-sync disabled (brew install fswatch)"
fi

if command -v python3 &>/dev/null; then
  python3 "$REPO_ROOT/video-server/server.py" &
  PIDS_TO_KILL+=($!)
  echo "[server] video server starting at http://localhost:5555"
else
  echo "[server] python3 not found — video server disabled"
fi

bundle exec jekyll serve --livereload
